NODE_ENV=production

# Server
PORT=3000
HOST=0.0.0.0

# Gmail SMTP (use a Gmail App Password - 16 chars, no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=yourgmailapppassword

# Address shown as the sender (optional - falls back to SMTP_USER)
EMAIL_FROM="RS Higher Education Consultants" info@rshec.pk

# Where to receive student inquiry emails
BUSINESS_EMAIL=rshighereducation@gmail.com

# ONLY needed if the API is on a different domain than the site.
# Comma separated, no trailing slash. Leave empty for same-domain setups.
ALLOWED_ORIGINS=

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
